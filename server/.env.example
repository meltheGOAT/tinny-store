# Server Environment Variables (.env)
PORT=5000
NODE_ENV=production

# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://username:password@ep-your-database.region.aws.neon.tech/neondb?sslmode=require"

# Admin Authentication Token Secret (Random 32-64 char string)
JWT_SECRET="your_secure_random_jwt_secret_here"

# Allowed Frontend Origins for CORS (comma-separated list of domains)
ALLOWED_ORIGINS="http://localhost:5173,https://your-frontend.vercel.app,https://your-app.up.railway.app"
CLIENT_URL="http://localhost:5173"

# Cloudinary Media Pipeline
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
